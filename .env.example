# Application Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL)
POSTGRES_USER=pokerlab
POSTGRES_PASSWORD=pokerlab_secret
POSTGRES_DB=pokerlab_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pokerlab:pokerlab_secret@postgres:5432/pokerlab_dev
DATABASE_SYNC_URL=postgresql+psycopg://pokerlab:pokerlab_secret@postgres:5432/pokerlab_dev

# Worker Configuration
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_CONCURRENCY=2

# Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://api:8000/api/v1
